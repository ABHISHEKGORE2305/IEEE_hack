// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  email     String?  @unique
  password  String?
  role      String  @default("user")
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  appointments Appointment[]
  profile String @default("https://cdn-icons-png.flaticon.com/512/6073/6073873.png")
  dob DateTime?
  address String?
  phone String?
  reports String[] @default([])
}

model Doctor {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  email     String?  @unique
  password  String?
  role      String?  @default("doctor")
  specialization String?
  verified  Boolean? @default(false)
  license String?
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  clinic Clinic ? @relation(fields: [clinicId], references: [id])
  clinicId String? @map("clinic_id") @db.ObjectId
  appointments Appointment[]
  profile String @default("https://cdn-icons-png.flaticon.com/512/6073/6073873.png")
  rating Int @default(0)
  experience Int @default(0)
  docrating Int[] @default([])
  finalrating Int @default(0)
}

model Clinic {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  address   String?
  phone     String?
  email     String? @unique
  doctors   Doctor[]
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model Appointment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @map("user_id") @db.ObjectId
  doctorId  String?  @map("doctor_id") @db.ObjectId
  date      String
  time      String?
  status    String?  @default("pending")
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  doctor    Doctor?  @relation(fields: [doctorId], references: [id])
}
